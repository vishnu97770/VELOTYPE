# ── Core ──────────────────────────────────────────────────────────────────────

# Long random string used to sign JWT tokens.  Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset the app refuses to start.
SECRET_KEY=your-long-random-secret-here

# "development" or "production" — controls cookie secure flag and reload mode
ENVIRONMENT=production

# SQLite locally, Postgres in production.
# On Render, link a PostgreSQL database and it sets this automatically.
# Local default (used when this var is absent): sqlite:///./velotypeai.db
DATABASE_URL=postgresql://user:password@host/dbname

# ── URLs ──────────────────────────────────────────────────────────────────────

# Full origin of this backend — used to build OAuth redirect_uris.
# MUST match what is registered in Google Cloud Console / GitHub OAuth app.
# Local default (used when absent): http://localhost:8000
# Production: https://velotype-2-jn34.onrender.com
BACKEND_URL=https://your-render-backend.onrender.com

# Full origin of the frontend — used for CORS and OAuth post-login redirects.
# Comma-separated to allow multiple origins (e.g. prod + preview).
# Local default (used when absent): http://localhost:5173
# Production: https://velotype-sigma.vercel.app
FRONTEND_URL=https://your-vercel-frontend.vercel.app

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com
#   → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
#
# Authorised JavaScript origins:
#   https://your-render-backend.onrender.com
#
# Authorised redirect URIs:
#   https://your-render-backend.onrender.com/api/v1/auth/google/callback
#   http://localhost:8000/api/v1/auth/google/callback   ← for local dev
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
#   Homepage URL:      https://your-vercel-frontend.vercel.app
#   Callback URL:      https://your-render-backend.onrender.com/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── AI paragraph generation ───────────────────────────────────────────────────
# At least one of these is required for AI-generated practice paragraphs.
# If none are set the app falls back to rule-based paragraph templates.
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Alternative key name (both are checked):
GOOGLE_API_KEY=your-google-api-key
