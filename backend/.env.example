# Copy this file to backend/.env and fill in real values there.
# backend/.env is gitignored — never commit real credentials.
# In production (Render), set these as dashboard environment variables instead.

# ── Core ─────────────────────────────────────────────────────────────
# JWT signing key. Required — the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-key-here

# SQLite locally, Postgres in production (Render provides this automatically
# for a linked database — just reference it, don't hardcode it here).
DATABASE_URL=sqlite:///./velotypeai.db

ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ── OAuth (social login) ────────────────────────────────────────────
# Leave unset to disable that provider — social_auth.py degrades gracefully.
GOOGLE_CLIENT_ID=your-key-here
GOOGLE_CLIENT_SECRET=your-key-here
GITHUB_CLIENT_ID=your-key-here
GITHUB_CLIENT_SECRET=your-key-here
BACKEND_URL=http://localhost:8000

# ── LLM paragraph generation (multi-provider) ───────────────────────
# All optional — with none set, the app falls back to the local "Mentor"
# generator (no network, no key required). Priority: Groq -> Together ->
# OpenRouter -> Mentor.
GROQ_API_KEY=your-key-here
TOGETHER_API_KEY=your-key-here
OPENROUTER_API_KEY=your-key-here

# Model names are provider catalogs that change over time — override here
# rather than hardcoding in source.
GROQ_MODEL=llama-3.1-8b-instant
TOGETHER_MODEL=your-key-here
OPENROUTER_MODEL=your-key-here

# Per-provider request timeout and total cross-provider budget, in seconds.
LLM_TIMEOUT_SECONDS=3
LLM_TOTAL_BUDGET_SECONDS=6
